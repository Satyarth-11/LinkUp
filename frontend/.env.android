# ---- Android Build Environment Variables ----
# Set this to your backend URL before building the APK.
#
# Option 1: Deployed backend (recommended for real device testing)
# VITE_API_URL=https://your-backend.onrender.com
#
# Option 2: Local backend via WiFi (phone + PC on same network)
# VITE_API_URL=http://192.168.1.XXX:5000
#
# Option 3: Android Emulator → Host machine
# VITE_API_URL=http://10.0.2.2:5000

VITE_API_URL=https://linkup-gqtd.onrender.com
